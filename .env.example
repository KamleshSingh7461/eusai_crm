# ---------------------------------------------------------------------------
# EuSai CRM environment template
#
# Copy this file to the env file for the environment you are configuring:
#   local       -> .env.local        (your machine, docker Postgres)
#   staging     -> .env.staging      (staging server / or locally to debug staging)
#   production  -> .env.production   (production server only)
#
# Env files are git-ignored. Never commit real secrets.
# Every key listed here is managed by scripts/env.mjs: keys missing from the
# selected env file are blanked so values never leak between environments.
# ---------------------------------------------------------------------------

# Which environment this is: local | staging | production
# (scripts/env.mjs sets this automatically from the npm script you run)
APP_ENV=local

# --- Core ------------------------------------------------------------------
# Public base URL of the app (no trailing slash). Used in emails and OAuth.
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32   (must differ per environment)
NEXTAUTH_SECRET=local-dev-secret-change-me-local-dev-secret

# PostgreSQL. Local default matches docker-compose.yml.
DATABASE_URL=postgresql://eusai:eusai@localhost:5432/eusai_crm?schema=public

# Needed when the app runs behind a proxy/load balancer (EC2 + Nginx)
AUTH_TRUST_HOST=true

# --- Google OAuth (login + calendar) ---------------------------------------
# Use a separate OAuth client (or at least separate redirect URIs) per env:
#   <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (SMTP via nodemailer) -------------------------------------------
# Local default points at Mailpit (http://localhost:8025). Leave SMTP_USER /
# SMTP_PASS empty locally; emails are then logged to the console or caught by Mailpit.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional SendGrid (src/services/EmailService.ts)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# --- Push notifications --------------------------------------------------
# Web push (browsers). Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Mobile push (Flutter app): Firebase service account JSON, on one line
FIREBASE_SERVICE_ACCOUNT=

# --- Scheduled jobs --------------------------------------------------------
# Shared secret for /api/cron/* (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=local-cron-secret

# --- AI --------------------------------------------------------------------
GEMINI_API_KEY=
GOOGLE_API_KEY=

# --- Optional --------------------------------------------------------------
MONGODB_URI=

# --- Local seeding only ----------------------------------------------------
# Your own Google account email; `npm run db:seed` makes it a DIRECTOR so you
# can sign in locally. Must be on an allowed domain (see src/lib/auth.ts).
SEED_DIRECTOR_EMAIL=
