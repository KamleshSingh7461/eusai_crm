{
  "name": "eusai_crm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "node scripts/env.mjs local next dev -H 0.0.0.0",
    "dev:staging": "node scripts/env.mjs staging next dev -H 0.0.0.0",
    "build": "prisma generate && next build",
    "build:local": "node scripts/env.mjs local npm run build",
    "build:staging": "node scripts/env.mjs staging npm run build",
    "build:production": "node scripts/env.mjs production npm run build",
    "start": "next start",
    "start:local": "node scripts/env.mjs local next start",
    "start:staging": "node scripts/env.mjs staging next start",
    "start:production": "node scripts/env.mjs production next start",
    "lint": "eslint",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "setup": "npm run services:up && npm run db:deploy && npm run db:seed",
    "db:migrate": "node scripts/env.mjs local prisma migrate dev",
    "db:deploy": "node scripts/env.mjs local prisma migrate deploy",
    "db:deploy:staging": "node scripts/env.mjs staging prisma migrate deploy",
    "db:deploy:production": "node scripts/env.mjs production prisma migrate deploy",
    "db:status:staging": "node scripts/env.mjs staging prisma migrate status",
    "db:status:production": "node scripts/env.mjs production prisma migrate status",
    "db:seed": "node scripts/env.mjs local prisma db seed",
    "db:seed:staging": "node scripts/env.mjs staging prisma db seed",
    "db:reset": "node scripts/env.mjs local prisma migrate reset",
    "db:studio": "node scripts/env.mjs local prisma studio",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.2",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "5.10.2",
    "@sendgrid/mail": "^8.1.6",
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "firebase-admin": "^12.0.0",
    "framer-motion": "^12.34.0",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "lodash": "^4.17.23",
    "lucide-react": "^0.564.0",
    "mongoose": "^9.2.1",
    "next": "^15.1.7",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.13",
    "prisma": "5.10.2",
    "qrcode": "1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "15.1.7",
    "tsx": "^4.19.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
